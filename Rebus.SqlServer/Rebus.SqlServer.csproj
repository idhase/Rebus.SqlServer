<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<RootNamespace>Rebus</RootNamespace>
		<AssemblyName>Rebus.SqlServer</AssemblyName>
		<Authors>mookid8000</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://rebus.fm/what-is-rebus/</PackageProjectUrl>
		<PackageDescription>Microsoft SQL Server-based persistence for Rebus</PackageDescription>
		<Copyright>Copyright Rebus FM ApS 2012</Copyright>
		<PackageTags>rebus queue messaging service bus sql-server sqlserver mssql sql</PackageTags>
		<PackageIcon>little_rebusbus2_copy-500x500.png</PackageIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<RepositoryUrl>https://github.com/idhase/Rebus.SqlServer.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<LangVersion>latest</LangVersion>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageId>Idha.Rebus.SqlServer</PackageId>
		<Version>1.0.9</Version>
		<AssemblyVersion>1.0.9</AssemblyVersion>
		<PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
		<PackageReleaseNotes>1.0.9: Messages from a failed handler attempt are no longer sent on 2nd level retries, SqlServerTimeoutManager no longer stalls for 30 seconds on a lock, and a handler's messages are inserted with multi-row INSERTs. Requires Rebus 8.9.0 and Microsoft.Data.SqlClient 6.1.2. See the package README for details and https://github.com/idhase/Rebus.SqlServer/blob/master/CHANGELOG.md for the full history.</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="microsoft.data.sqlclient" Version="6.1.2" />
		<PackageReference Include="rebus" Version="8.9.0" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\artwork\little_rebusbus2_copy-500x500.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="..\PACKAGE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
